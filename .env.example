# ==============================================================================
# CONFIGURAZIONE AMBIENTE OFFERTISSIMESCONTI (PRODUZIONE)
# Copia questo file in .env e inserisci i valori reali
# ==============================================================================

# 1. Telegram Bot Token generato da @BotFather
# (es. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# 2. ID o Username del Canale Telegram Ufficiale
# (es. @offertissimesconti_radar oppure -1003838698998)
TELEGRAM_CHANNEL_ID=-1003838698998

# 3. Tag Affiliato Ufficiale Amazon Associates
AMAZON_AFFILIATE_TAG=offertissimes-21

# 4. Porta Web Server / REST API
PORT=8000

# 5. Frequenza di pubblicazione automatica sul Canale Telegram (in secondi, 600 = 10 minuti)
BROADCAST_INTERVAL=600
